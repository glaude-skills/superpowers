#!/usr/bin/env bash
# SessionStart hook for superpowers plugin

set -euo pipefail

# Determine plugin root directory
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read using-superpowers content
using_superpowers_content=$(cat "${PLUGIN_ROOT}/skills/using-superpowers/SKILL.md" 2>&1 || echo "Error reading using-superpowers skill")

# Escape string for JSON embedding using bash parameter substitution.
# Each ${s//old/new} is a single C-level pass - orders of magnitude
# faster than the character-by-character loop this replaces.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

nl=$'\n'
# The skill keeps its detail in references/ and routes to it by relative path,
# so name the directory those paths start from (a Windows path where the Read
# tool expects one).
skill_dir="${PLUGIN_ROOT}/skills/using-superpowers"
if command -v cygpath >/dev/null 2>&1; then
    skill_dir=$(cygpath -w "$skill_dir")
fi
context_head="<EXTREMELY_IMPORTANT>${nl}You have superpowers.${nl}${nl}**Below is the full content of your 'superpowers:using-superpowers' skill - your introduction to using skills. For all other skills, use the 'Skill' tool:**${nl}${nl}Skill directory for its relative paths (references/, scripts/): ${skill_dir}${nl}${nl}"
context_tail="${nl}</EXTREMELY_IMPORTANT>"
session_context_plain="${context_head}${using_superpowers_content}${context_tail}"

# Size guard. Claude Code caps each hook context string at 10,000 characters;
# over the cap it saves the text to a file and shows the model only the first
# 2,000 characters, without asking it to read the rest. Up to 6.4.96 the
# 54.7 KB bootstrap was cut that way in every session. Warn at the very front,
# where the preview still shows it, instead of letting it be cut silently.
# Characters are counted as UTF-8 code points (bytes minus continuation bytes),
# so the count does not depend on the locale. The SKILL.md cap itself (9,000)
# is checked by tests/claude-code/test-skill-context-budget.sh.
CONTEXT_CHAR_CAP=10000
context_chars=$(printf '%s' "$session_context_plain" | LC_ALL=C tr -d '\200-\277' | wc -c | tr -d '[:space:]')
if [ "$context_chars" -gt "$CONTEXT_CHAR_CAP" ]; then
    size_warning="경고: superpowers using-superpowers 부트스트랩이 ${context_chars}자로 hook 상한 ${CONTEXT_CHAR_CAP}자를 넘어 앞 2,000자만 전달될 수 있다. skills/using-superpowers/SKILL.md 의 상세를 references/ 로 옮겨야 한다(references/context-budget.md). 전체 내용은 아래 저장 파일 경로에 있다."
    session_context_plain="${size_warning}${nl}${nl}${session_context_plain}"
fi

session_context=$(escape_for_json "$session_context_plain")

# Output context injection as JSON.
# Cursor hooks expect additional_context (snake_case).
# Claude Code hooks expect hookSpecificOutput.additionalContext (nested).
# Copilot CLI (v1.0.11+) and others expect additionalContext (top-level, SDK standard).
# Claude Code reads BOTH additional_context and hookSpecificOutput without
# deduplication, so we must emit only the field the current platform consumes.
# Muse sets MUSE_PLUGIN_ROOT and expects additionalContext (SDK standard).
#
# Uses printf instead of heredoc to work around bash 5.3+ heredoc hang.
# See: https://github.com/obra/superpowers/issues/571
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  # Cursor sets CURSOR_PLUGIN_ROOT (may also set CLAUDE_PLUGIN_ROOT)
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context" | cat
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ] && [ -z "${MUSE_PLUGIN_ROOT:-}" ]; then
  # Claude Code sets CLAUDE_PLUGIN_ROOT without COPILOT_CLI/MUSE_PLUGIN_ROOT
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
elif [ -n "${MUSE_PLUGIN_ROOT:-}" ]; then
  # Muse sets MUSE_PLUGIN_ROOT — try Claude-style nested output for Muse Spark
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
else
  # Copilot CLI (sets COPILOT_CLI=1) or unknown platform — SDK standard format
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context" | cat
fi

exit 0
